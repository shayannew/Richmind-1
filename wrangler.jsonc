  ],
  "vars": {
    "SITE_NAME": "RichMind",
    "PUBLIC_BASE_URL": "https://richmind-1.shayannew0209.workers.dev",
    "GOOGLE_CLIENT_ID": "59225715425-6mvrp46hc1s3nuj5fi81t92gqs2oj8mk.apps.googleusercontent.com",
    "PAYMENT_MODE": "test",
    "SUPPORT_EMAIL": ""
  }
}
