{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rava-staging",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/products/*"
    ]
  }
}
