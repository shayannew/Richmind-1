{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richmind-1",
  "main": "worker.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
